# =====================================
# Configuration Azure AI Search (basée sur Azure AI Foundry)
# =====================================

# Strictness: Niveau de filtrage des documents (1-5)
# Valeur actuelle selon votre configuration Azure Foundry: 1 (filtrage minimal)
AZURE_SEARCH_STRICTNESS=1

# Retrieved documents: Nombre de documents à récupérer (3-20)
# Valeur actuelle selon votre configuration Azure Foundry: 20 documents
AZURE_SEARCH_RETRIEVED_DOCUMENTS=20

# Limit to data content: Limiter les réponses aux données indexées
# Valeur actuelle selon votre configuration Azure Foundry: true (case cochée)
AZURE_SEARCH_LIMIT_TO_DATA_CONTENT=true
