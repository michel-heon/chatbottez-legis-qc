# This file includes environment variables for Cotechnoe production tenant

# Built-in environment variables
TEAMSFX_ENV=cotechnoe
APP_NAME_SUFFIX=cotechnoe

# Azure subscription and resource configuration (production)
AZURE_SUBSCRIPTION_ID=0f1323ea-0f29-4187-9872-e1cf15d677de
AZURE_RESOURCE_GROUP_NAME=rg-chabottez-legis-qc-01
RESOURCE_SUFFIX=botf2c163

# Generated during provision - Production values from dev environment
BOT_ID=abf6e2c6-7b9d-4c04-abb8-f3d55a2c3cef
TEAMS_APP_ID=842aedc5-cc21-42fc-b4a3-ae409c595d88
BOT_AZURE_APP_SERVICE_RESOURCE_ID=/subscriptions/0f1323ea-0f29-4187-9872-e1cf15d677de/resourceGroups/rg-chabottez-legis-qc-01/providers/Microsoft.Web/sites/botbotf2c163
