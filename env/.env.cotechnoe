DEBUG=false

# =====================================
# Configuration Azure AI Search (Production)
# =====================================

# Strictness: Niveau de filtrage des documents (1-5)
AZURE_SEARCH_STRICTNESS=1

# Retrieved documents: Nombre de documents à récupérer (3-20)
AZURE_SEARCH_RETRIEVED_DOCUMENTS=20

# Limit to data content: Limiter les réponses aux données indexées
AZURE_SEARCH_LIMIT_TO_DATA_CONTENT=true

# Teams App Configuration (Production)
TEAMS_APP_UPDATE_TIME=
TEAMS_APP_TENANT_ID=b3e0cd9f-e153-429c-8371-e8dd3df72ff7
