# Azure OpenAI Configuration (Production)
AZURE_OPENAI_ENDPOINT='https://openai-cotechnoe.openai.azure.com/'
AZURE_OPENAI_DEPLOYMENT_NAME='gpt-4.1'
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=text-embedding-ada-002
