# ====================================
# Configuration Azure AI Search
# Paramètres basés sur Azure AI Foundry
# ====================================

# Niveau de strictness pour le filtrage des documents (1-5)
# 1 = Filtrage minimal (inclut plus de documents, potentiellement moins pertinents)
# 3 = Équilibré (recommandé par Microsoft par défaut)
# 5 = Filtrage agressif (inclut seulement les documents très pertinents)
# Valeur configurée selon votre image: 1
AZURE_SEARCH_STRICTNESS=1

# Nombre de documents à récupérer (3-20)
# Plus de documents = plus de contexte, mais plus de tokens utilisés
# Valeur configurée selon votre image: 20
AZURE_SEARCH_RETRIEVED_DOCUMENTS=20

# Limiter les réponses au contenu de vos données uniquement (true/false)
# true = Le modèle utilise seulement les informations de votre index (recommandé pour RAG)
# false = Le modèle peut utiliser ses connaissances générales en plus de vos données
# Valeur configurée selon votre image: true (case cochée)
AZURE_SEARCH_LIMIT_TO_DATA_CONTENT=true

# ====================================
# Documentation des bonnes pratiques
# ====================================
#
# Selon Microsoft Azure OpenAI On Your Data:
#
# STRICTNESS:
# - Contrôle l'agressivité du filtrage basé sur les scores de similarité
# - Filtrage des documents avec des scores de similarité faibles
# - Plus le niveau est élevé, plus le seuil de similarité est strict
#
# RETRIEVED DOCUMENTS:
# - Contrôle la quantité d'informations (tokens) incluse dans le prompt
# - Formule: chunk_size × retrieved_documents = total_tokens
# - Équilibrage entre contexte et performance
#
# LIMIT TO DATA CONTENT:
# - Active le pattern RAG (Retrieval Augmented Generation)
# - Assure que les réponses sont basées sur vos documents indexés
# - Évite les hallucinations basées sur les connaissances du modèle
#
