# Configuration SMTP pour l'envoi d'emails
# Copier ce fichier vers .smtp.env et ajuster les valeurs

# Serveur SMTP (Office 365 ou Gmail)
SMTP_SERVER="smtp.office365.com"
SMTP_PORT="587"

# Credentials (utiliser un mot de passe d'application si MFA activé)
SMTP_USER="heon@cotechnoe.com"
SMTP_PASSWORD="YOUR_APP_PASSWORD_HERE"

# Transport d'email (smtp ou graph)
EMAIL_TRANSPORT="smtp"

# Paramètres de sécurité
SMTP_USE_TLS="true"
SMTP_USE_SSL="false"
