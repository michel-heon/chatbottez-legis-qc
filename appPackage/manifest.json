{
    "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.24/MicrosoftTeams.schema.json",
    "manifestVersion": "1.24",
    "version": "1.0.0",
    "id": "${{TEAMS_APP_ID}}",
    "developer": {
        "name": "Cotechnoe",
        "websiteUrl": "https://www.cotechnoe.net",
        "privacyUrl": "https://chatbottez-legis-qc.cotechnoe.net/privacy.html",
        "termsOfUseUrl": "https://chatbottez-legis-qc.cotechnoe.net/terms.html"
    },
    "icons": {
        "color": "color.png",
        "outline": "outline.png"
    },
    "name": {
        "short": "Légis Québec${{APP_NAME_SUFFIX}}",
        "full": "Légis Québec - Assistant juridique pour les lois du Québec"
    },
    "description": {
        "short": "Assistant juridique spécialisé dans les lois du Québec",
        "full": "Légis Québec est un assistant juridique intelligent spécialisé dans les lois et règlements du Québec, utilisant Azure AI Search pour fournir des réponses précises basées sur la documentation officielle."
    },
    "accentColor": "#FFFFFF",
    "copilotAgents": {
        "customEngineAgents": [
            {
                "type": "bot",
                "id": "${{BOT_ID}}"
            }
        ]
    },
    "bots": [
        {
            "botId": "${{BOT_ID}}",
            "scopes": [
                "copilot",
                "personal",
                "team"
            ],
            "supportsFiles": false,
            "isNotificationOnly": false,
            "commandLists": [
                {
                    "scopes": [
                        "copilot",
                        "personal"
                    ],
                    "commands": [
                        {
                            "title": "Comment peux-tu m'aider?",
                            "description": "Découvrir les fonctionnalités de Légis Québec"
                        },
                        {
                            "title": "Quelles lois sont disponibles?",
                            "description": "Liste des lois du Québec disponibles dans la base"
                        },
                        {
                            "title": "Explique-moi cette loi",
                            "description": "Explication détaillée d'une loi spécifique"
                        }
                    ]
                }
            ]
        }
    ],
    "composeExtensions": [],
    "configurableTabs": [],
    "staticTabs": [],
    "permissions": [
        "identity",
        "messageTeamMembers"
    ],
    "validDomains": []
}