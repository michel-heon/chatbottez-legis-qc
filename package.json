{
  "name": "legisqc",
  "version": "1.0.0",
  "msteams": {
    "teamsAppId": null
  },
  "description": "Microsoft 365 Agents Toolkit RAG Bot Sample with Azure AI Search and Teams AI Library",
  "engines": {
    "node": "18 || 20 || 22"
  },
  "author": "Microsoft",
  "license": "MIT",
  "main": "./lib/src/index.js",
  "scripts": {
    "dev:teamsfx": "env-cmd --silent -f .localConfigs npm run dev",
    "dev:teamsfx:testtool": "env-cmd --silent -f .localConfigs.playground npm run dev",
    "dev:teamsfx:launch-testtool": "env-cmd --silent -f env/.env.playground teamsapptester start",
    "dev": "nodemon --exec node --inspect=9239 --signal SIGINT -r ts-node/register ./src/index.ts",
    "build": "tsc --build && shx cp -r ./src/prompts ./lib/src",
    "start": "node ./lib/src/index.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "watch": "nodemon --exec \"npm run start\"",
    "indexer:setup": "npm run build && make index-populate ENV_CONFIG=playground",
    "indexer:test": "npm run build && make index-test ENV_CONFIG=playground"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com"
  },
  "dependencies": {
    "@azure/search-documents": "^12.0.0",
    "@microsoft/teams-ai": "^1.5.3",
    "@types/rdflib": "^0.20.1",
    "botbuilder": "^4.23.1",
    "dotenv": "^17.2.1",
    "express": "^5.0.1",
    "n3": "^1.26.0",
    "pdf-parse": "^1.1.1",
    "rdflib": "^2.2.37",
    "sparqljs": "^3.7.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^18.0.0",
    "@types/pdf-parse": "^1.1.5",
    "env-cmd": "^10.1.0",
    "nodemon": "^3.1.7",
    "shx": "^0.3.3",
    "ts-node": "^10.4.0",
    "typescript": "^5.5.4"
  },
  "config": {
    "azure_search_index_name": "test-index"
  }
}
