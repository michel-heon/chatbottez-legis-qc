{
    "name": "chatbottezlegisqcappgen",
    "version": "4.0.0-alpha.3",
    "msteams": {
        "teamsAppId": null
    },
    "description": "Légis Québec - Custom Engine Agent for Microsoft 365 Copilot with RAG",
    "engines": {
        "node": "20 || 22"
    },
    "author": "Cotechnoe inc.",
    "license": "MIT",
    "main": "./src/index.js",
    "scripts": {
        "env:sync": "node ./scripts/sync-shared-env.js",
        "dev:teamsfx": "env-cmd --silent -f .localConfigs npm run dev",
        "dev:teamsfx:testtool": "env-cmd --silent -f .localConfigs.playground npm run dev",
        "dev:teamsfx:launch-testtool": "env-cmd --silent -f env/common.env -f env/.env.playground teamsapptester start",
        "dev": "node ./scripts/free-port.js 9239 && nodemon --exec node --inspect=9239 --signal SIGINT ./src/index.js",
        "build": "echo 'No build step needed for JavaScript'",
        "start": "node ./src/index.js",
        "test": "echo \"Error: no test specified\" && exit 1",
        "watch": "nodemon --exec \"npm run start\"",
        "indexer:create": "npm run build && shx cp -r ./src/indexers/data ./lib/src/indexers && env-cmd --silent -f env/.env.playground.user node ./lib/src/indexers/setup.js",
        "indexer:delete": "npm run build && env-cmd --silent -f env/.env.playground.user node ./lib/src/indexers/delete.js"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com"
    },
    "dependencies": {
        "@azure/identity": "^4.11.1",
        "botbuilder": "^4.22.0",
        "openai": "^4.77.0",
        "restify": "^11.1.0"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "env-cmd": "^10.1.0",
        "nodemon": "^3.1.7",
        "shx": "^0.3.3",
        "ts-node": "^10.4.0",
        "typescript": "~5.8.3"
    }
}
